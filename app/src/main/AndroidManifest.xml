<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.blackmensa.ddtool">

    <!-- ELIMINAR ESTA LINEA AL TERMINAR LA APP -->

    <application
        android:debuggable="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity android:name=".Activities.LoginActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".Activities.MainMenuActivity"></activity>
        <activity android:name=".Activities.TirarDadosActivity"></activity>
        <activity android:name=".Activities.RoomListActivity"></activity>
        <activity android:name=".Activities.RoomActivity"></activity>
        <activity android:name=".Activities.CreateRoomActivity"></activity>
        <activity android:name=".Activities.ProfileListActivity"></activity>
        <activity android:name=".Activities.CreateProfileActivity"></activity>
    </application>

</manifest>